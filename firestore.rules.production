rules_version = '2';

// Hardened starting rules for PRODUCTION. Swap this in for firestore.rules
// before deploying (see PRODUCTION.md). Keep the permissive firestore.rules
// for local emulator development.
//
// NOTE: token issuance currently happens client-side, so `services` writes and
// `tokens` creates are still allowed publicly. For a fully locked-down launch,
// move issueToken/advanceQueue to Cloud Functions and remove those allowances.

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if signedIn() && role() == 'super';
    }

    // Public business + service info powers discovery and the live queue.
    match /businesses/{bizId} {
      allow read: if true;
      allow write: if signedIn() && role() in ['admin', 'super'];

      match /services/{svcId} {
        allow read: if true;
        allow write: if signedIn();
      }
      match /branches/{branchId} {
        allow read: if true;
        allow write: if signedIn() && role() in ['admin', 'super'];
      }
      match /rooms/{roomId} {
        allow read: if true;
        allow write: if signedIn() && role() in ['admin', 'super'];
      }
    }

    // Tokens: anyone can take a token (guest booking) and read the queue;
    // only signed-in staff/admin can advance/cancel/delete.
    match /tokens/{tokenId} {
      allow read, create: if true;
      allow update, delete: if signedIn();
    }

    // Role docs: owner can read their own; writes are server-side only.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Feedback: anyone can submit, only staff/admin can read.
    match /feedback/{id} {
      allow create: if true;
      allow read: if signedIn();
    }
  }
}
